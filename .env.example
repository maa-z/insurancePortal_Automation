# AI Mode Configuration: 'mock' (default, offline deterministic) or 'llm' (OpenAI-compatible)
AI_MODE=mock

# Real LLM Configuration (Required only when AI_MODE=llm)
# Free open-source inference via Groq (Recommended - Get free key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative models on Groq: "llama-3.1-8b-instant", "openai/gpt-oss-120b", "qwen/qwen3.8-27b"

# OpenAI Configuration (Optional fallback if GROQ_API_KEY is not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Browser Automation: Headless mode ('false' by default so browser execution is visible)
HEADLESS=false

# Service Ports & Endpoints
PORTAL_BASE_URL=http://localhost:5173/portal
DATABASE_URL=sqlite:///./insurance_agent.db
